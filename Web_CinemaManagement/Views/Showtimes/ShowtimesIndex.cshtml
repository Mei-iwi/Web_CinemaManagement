@model List<Web_CinemaManagement.Models.ADO.ShowtimeViewModel>
<link href="~/wwwroot/css/DashboardCustomer.css" rel="stylesheet" />
<div class="container mt-4">
    <h1 class="text text-xl-center">Lịch Chiếu Phim</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Hiện tại chưa có lịch chiếu nào.
        </div>
    }
    else
    {
        foreach (var dateGroup in Model)
        {
            <h2 class="text-warning">@dateGroup.Date.ToString("dddd, dd/MM/yyyy")</h2>

            foreach (var movieGroup in dateGroup.MovieGroups)
            {
                <div class="card mb-3">
                    <div class="row">
                        <div class="col-md-3">
                            <img width="180" src="@Url.Content("~/wwwroot/PhotoOfTheFilm/"+movieGroup.HinhAnh)" class="img-fluid" />
                        </div>
                        <div class="col-md-9 p-5">
                            <h4>@movieGroup.TenPhim</h4>
                            <p>Thời lượng: @movieGroup.ThoiLuong phút</p>
                            <div>
                                @foreach (var showtime in movieGroup.AvailableShowtimes)
                                {
                                    <a href="@Url.Action("SelectSeats", "Booking", new { id = showtime.MaSuat })" class="btn btn-outline-primary">
                                        @showtime.GioBatDau.ToString(@"hh\:mm") - @showtime.TenPhong
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>
