
@{
    Layout = null;

    int pos = (int)ViewBag.Pos;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/wwwroot/Bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/wwwroot/css/ForgetPassword.css" rel="stylesheet" />
    <title>ForgetPassword</title>
</head>
<body>
    <div class="row bg-dark">
        <div style="height:100vh" class="col-sm-6 col-6 background"></div>
        <div style="height:100vh; z-index:1000" class="col-sm-6 col-6 w-100 d-flex align-items-center flex-column justify-content-sm-center">
            <h1 class="text-light">Thay đổi mật khẩu</h1>

            <div class="changePass text-light d-flex justify-content-center align-items-center w-100">
                @using (Html.BeginForm("ChangePassWordUser", "Authentication", FormMethod.Post, new { @class = "w-75" }))
                {
                    @Html.Hidden("User", null);
                    <div class="form-group">
                        @Html.Label("NewPass", "Nhập mật khẩu hiện tại")
                        @Html.TextBox("PassOld", null, new { @class = "form-control", type = "password" })
                    </div>
                    <div class="form-group d-flex ml-4">
                        @Html.CheckBox("checkPassOld", false, new { @class = "form-check" })
                        <span class="ml-3">Hiện thị mật khẩu</span>
                    </div>
                    <div class="form-group">
                        @Html.Label("NewPass", "Nhập mật khẩu mới")
                        @Html.TextBox("NewPass", null, new { @class = "form-control", type = "password" })
                    </div>
                    <div class="form-group d-flex ml-4">
                        @Html.CheckBox("checkpassNew", false, new { @class = "form-check" })
                        <span class="ml-3">Hiện thị mật khẩu</span>
                    </div>
                    <div class="form-group">
                        @Html.Label("NewPassAgain", "Nhập lại mật khẩu mới")
                        @Html.TextBox("NewPassAgain", null, new { @class = "form-control", type = "password" })
                    </div>
                    <div class="form-group d-flex ml-4">
                        @Html.CheckBox("checkpassAgain", false, new { @class = "form-check" })
                        <span class="ml-3">Hiện thị mật khẩu</span>
                    </div>

                    <div class="form-group">
                        <button id="send" type="submit" class="btn btn-block btn-primary">Đổi mật khẩu</button>
                    </div>

                    <span id="diff" class="text-center"></span>


                }
            </div>
            <span class="text-success"><strong>@ViewBag.mess</strong></span>
            <span class="text-danger"><strong>@ViewBag.err</strong></span>
            @if (pos == 0)
            {
                @Html.ActionLink("Quay lại trang chủ", "Dashboard", "Home", new { area = "" }, null)
            }
            else if (pos == 1)
            {
                @Html.ActionLink("Quay lại trang chủ", "Dashboard", "Home", new { area = "Employee" }, null)
            }
            else if (pos == 2)
            {
                @Html.ActionLink("Quay lại trang chủ", "Dashboard", "Home", new { area = "Manager" }, null)
            }
            else
            {
                @Html.ActionLink("Quay lại trang chủ", "Login", "Authentication", new { area = "" }, null)
            }
        </div>
    </div>
    <script src="~/wwwroot/Bootstrap/js/jquery-3.3.1.min.js"></script>
    <script src="~/wwwroot/Bootstrap/js/bootstrap.min.js"></script>
    <script>
        var confirmcode = "";

        var checkpassNew = document.getElementById("checkpassNew");

        var checkpassAgain = document.getElementById("checkpassAgain");


        var checkPassOld = document.getElementById("checkPassOld");


        var pass = document.querySelectorAll(".changePass input[type='password']");


        checkPassOld.addEventListener("change", function () {
            if (this.checked) {
                pass[0].type = "text";
            }
            else {
                pass[0].type = "password";

            }
        });

        checkpassNew.addEventListener("change", function () {
            if (this.checked) {
                pass[1].type = "text";
            }
            else {
                pass[1].type = "password";

            }
        });

        checkpassAgain.addEventListener("change", function () {
            if (this.checked) {
                pass[2].type = "text";
            }
            else {
                pass[2].type = "password";

            }
        });

        var form = document.querySelector(".changePass form");

        var newPass = document.querySelector("input[name='NewPass']");
        var newPassAgain = document.querySelector("input[name='NewPassAgain']");

        form.addEventListener("submit", function (e) {
            $("#diff").text("");
            if (newPass.value !== newPassAgain.value) {
                e.preventDefault();
                $("#diff").text("Mật khẩu nhập lại không chính xác");
            }
        });


    </script>
</body>
</html>
