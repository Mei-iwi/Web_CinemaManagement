@model Web_CinemaManagement.Models.ModelLinq.NHANVIEN
@{
    ViewBag.Title = "AddEmployee";
    Layout = "~/Areas/Manager/Views/Shared/_LayoutPageManager.cshtml";
}

<style>
    body {
        background-color: #f8f9fa !important;
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center fs-4 fw-bold rounded-top-4">
                    🧑‍💻 Thêm Nhân Viên Mới
                </div>
                <div class="card-body px-4 py-4">
                    @using (Html.BeginForm("AddEmployee", "EmployeeManagement", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.HOTENNV, "Họ Tên", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.HOTENNV, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.HOTENNV, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.SDT, "Số Điện Thoại", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.SDT, new { @class = "form-control", type = "tel" })
                                @Html.ValidationMessageFor(m => m.SDT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.PHAI, "Giới tính", new { @class = "form-label fw-bold" })

                                @Html.DropDownListFor(
                                    m => m.PHAI,
                                    new SelectList(new List<string> { "NAM", "NỮ" }),
                                    "Chọn giới tính",
                                    new { @class = "form-control" }
                                )
                                @Html.ValidationMessageFor(m => m.PHAI, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.NGAYSINH, "Ngày Sinh", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.NGAYSINH, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.NGAYSINH, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.DIACHI, "Địa Chỉ", new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.DIACHI, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.DIACHI, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.EMAIL, "Email", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.EMAIL, new { @class = "form-control", type = "email" })
                                @Html.ValidationMessageFor(m => m.EMAIL, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.CHUCVU, "Chức Vụ", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.CHUCVU, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CHUCVU, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.LUONG, "Lương", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.LUONG, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.LUONG, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.CATRUC, "Ca trực", new { @class = "form-label fw-bold" })

                                @Html.DropDownListFor(
                                    m => m.CATRUC,
                                    new SelectList(new List<string> { "SÁNG", "CHIỀU", "TỐI" }),
                                    "Chọn ca trực",
                                    new { @class = "form-control" }
                                )
                                @Html.ValidationMessageFor(m => m.CATRUC, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.MA_NQL, "Người Quản Lý", new { @class = "form-label fw-bold" })
                            @Html.DropDownListFor(
                                m => m.MA_NQL,
                                new SelectList(ViewBag.DanhSachQuanLy, "MANV", "HOTENNV"),
                                "Chọn người quản lý (Tùy chọn)",
                                new { @class = "form-control" }
                            )
                            @Html.ValidationMessageFor(m => m.MA_NQL, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index", "EmployeeManagement")" class="btn btn-outline-secondary">
                                ⬅ Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-success px-4">💾 Lưu nhân viên</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>