@model Web_CinemaManagement.Models.ModelLinq.DICHVU

@{
    ViewBag.Title = "Thêm dịch vụ";
}

<link href="~/wwwroot/css/KhachHangManager.css" rel="stylesheet" />

<div class="cinema-management-page">

    <h2>Thêm dịch vụ</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">

            <div class="form-group">
                @Html.LabelFor(model => model.MASP)
                @Html.TextBoxFor(model => model.MASP, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.TENSP)
                @Html.TextBoxFor(model => model.TENSP, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.DONGIA)
                @Html.TextBoxFor(model => model.DONGIA, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.HINH_ANH)
                @Html.TextBoxFor(model => model.HINH_ANH, new { @class = "form-control" })
            </div>

            <br />
            <input type="submit" value="Thêm" class="btn btn-primary" />
            @Html.ActionLink("Quay lại", "Index")
        </div>
    }
</div>
