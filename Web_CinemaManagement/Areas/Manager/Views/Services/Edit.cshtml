@model Web_CinemaManagement.Models.ModelLinq.DICHVU

@{
    ViewBag.Title = "Cập nhật dịch vụ";
}

<link href="~/wwwroot/css/KhachHangManager.css" rel="stylesheet" />

<div class="cinema-management-page">

    <h2>Cập nhật dịch vụ</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.MASP)

        <div class="form-horizontal">

            <div class="form-group">
                @Html.LabelFor(m => m.TENSP)
                @Html.TextBoxFor(m => m.TENSP, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.DONGIA)
                @Html.TextBoxFor(m => m.DONGIA, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.HINH_ANH)
                @Html.TextBoxFor(m => m.HINH_ANH, new { @class = "form-control" })
            </div>

            <br />
            <input type="submit" value="Lưu" class="btn btn-primary" />
            @Html.ActionLink("Quay lại", "Index")
        </div>
    }
</div>
