@model IEnumerable<Web_CinemaManagement.Models.ModelLinq.DICHVU>

@{
    ViewBag.Title = "Quản lý dịch vụ";
}

<link href="~/wwwroot/css/KhachHangManager.css" rel="stylesheet" />

<div class="cinema-management-page">

    <h2>Dịch vụ</h2>

    <p>
        @Html.ActionLink("Thêm dịch vụ", "Create")
    </p>

    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MASP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TENSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DONGIA)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HINH_ANH)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MASP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TENSP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DONGIA)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HINH_ANH)
                </td>

                <td>
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.MASP }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.MASP }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.MASP })
                </td>
            </tr>
        }

    </table>
</div>
