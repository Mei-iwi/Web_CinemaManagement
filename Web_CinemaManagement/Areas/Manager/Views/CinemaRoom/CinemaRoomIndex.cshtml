@model Web_CinemaManagement.Models.RoomSeat.CinemaRoomIndexViewModel

@{
    ViewBag.Title = "Quản Lý Phòng Chiếu";
}

<div class="container-fluid mt-4">

    <h2 class="text-center text-primary">
        📽 @ViewBag.Title
    </h2>
    <hr />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="@Url.Action("Create")" class="btn btn-success">
                + Thêm phòng mới
            </a>
        </div>
        <div>
            @using (Html.BeginForm("TimKiemTheoTen", "CinemaRoom", FormMethod.Get, new { @class = "d-flex" }))
            {
                <div class="input-group">
                    <input type="text" name="keyword" class="form-control"
                           placeholder="Tìm theo tên phòng..." value="@ViewBag.CurrentFilter" />
                    <div class="input-group-append ">
                        <button type="submit" class="btn btn-outline-info">
                            🔍
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row">

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Danh sách phòng chiếu</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-bordered">
                            <thead class="thead-light text-center">
                                <tr>
                                    <th>Mã Phòng</th>
                                    <th>Tên Phòng</th>
                                    <th>Tổng Số Ghế</th>
                                    <th style="width: 250px;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PhongChieus)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @Html.DisplayFor(modelItem => item.MAPHONG)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.TENPHONG)
                                        </td>
                                        <td class="text-center">
                                            @Html.DisplayFor(modelItem => item.TONGSOGHE)
                                        </td>
                                        <td class="text-center">
                                            @Html.ActionLink("Sửa", "Edit", new { id = item.MAPHONG }, new { @class = "btn btn-warning btn-sm mx-1" })
                                            @Html.ActionLink("Chi tiết", "Details", new { id = item.MAPHONG }, new { @class = "btn btn-info btn-sm mx-1" })
                                            @Html.ActionLink("Xóa", "Delete", new { id = item.MAPHONG }, new { @class = "btn btn-danger btn-sm mx-1" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div> <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Quản lý Loại Ghế</h5>
                </div>
                <div class="card-body">
                    <p>
                        @Html.ActionLink("Thêm loại ghế mới", "CreateSeatType", null, new { @class = "btn btn-success btn-sm btn-block" })
                    </p>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-bordered">
                            <thead class="thead-light text-center">
                                <tr>
                                    <th>Mã Loại</th>
                                    <th>Tên Loại Ghế</th>
                                    <th style="width: 150px;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Ghes)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @Html.DisplayFor(modelItem => item.MAGHE)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.LOAIGHE)
                                        </td>
                                        <td class="text-center">
                                            @Html.ActionLink("Sửa", "EditSeatType", new { id = item.MAGHE }, new { @class = "btn btn-warning btn-sm mx-1" })
                                            @Html.ActionLink("Xóa", "DeleteSeatType", new { id = item.MAGHE }, new { @class = "btn btn-danger btn-sm mx-1" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>