@using Web_CinemaManagement.Helper;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Manager/Views/Shared/_LayoutPageManager.cshtml";


    var user = Session["User"] as Employee;
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-fluid py-4">
    <!-- Chào mừng + Thông tin nhanh -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-gradient-primary text-white shadow-lg border-0">
                <div class="card-body d-flex align-items-center justify-content-sm-between text-warning">
                    <div>
                        <h2 class="mb-1">
                            <i class="bi bi-stars text-warning"></i> Chào mừng trở lại, Quản lý @ViewBag.HoTen!
                        </h2>
                        <p class="mb-0 opacity-90">
                            Hôm nay là <strong>@DateTime.Now.ToString("dddd, dd/MM/yyyy")</strong> —
                            Ca làm việc: <strong class="text-warning">@ViewBag.CaLamViec @user.Catruc</strong>
                        </p>
                    </div>
                    <div class="ms-auto text-center">
                        <h1 class="display-1 mb-0">@DateTime.Now.ToString("HH:mm")</h1>
                        <small class="opacity-75">Giờ hệ thống</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 6 ô thống kê quan trọng -->
    <div class="row g-4 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card bg-dark text-white border-success shadow h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-ticket-perforated fs-1 text-success"></i>
                    <h4 class="mt-3 mb-0">8,429</h4>
                    <small>Vé đã bán hôm nay</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card bg-dark text-white border-warning shadow h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-currency-exchange fs-1 text-warning"></i>
                    <h4 class="mt-3 mb-0">356 triệu</h4>
                    <small>Doanh thu hôm nay</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card bg-dark text-white border-info shadow h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-people-fill fs-1 text-info"></i>
                    <h4 class="mt-3 mb-0">1,284</h4>
                    <small>Khách đang trong rạp</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card bg-dark text-white border-danger shadow h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-film fs-1 text-danger"></i>
                    <h4 class="mt-3 mb-0">18/24</h4>
                    <small>Suất chiếu đang chạy</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card bg-dark text-white border-primary shadow h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-person-check fs-1 text-primary"></i>
                    <h4 class="mt-3 mb-0">22/28</h4>
                    <small>Nhân viên đang làm</small>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6">
            <div class="card bg-dark text-white border-secondary shadow h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-bell fs-1 text-secondary"></i>
                    <h4 class="mt-3 mb-0">5</h4>
                    <small>Thông báo mới</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Biểu đồ doanh thu theo ca hôm nay -->
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-lg border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Doanh thu theo ca hôm nay</h5>
                    <small>@DateTime.Now:dd/MM/yyyy</small>
                </div>
                <div class="card-body">
                    <canvas id="revenueTodayChart" height="300"></canvas>
                </div>
            </div>
        </div>

        <!-- Nhiệm vụ & Thông báo nhanh -->
        <div class="col-lg-4">
            <div class="card bg-dark text-white shadow-lg border-0 mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-list-check"></i> Nhiệm vụ hôm nay</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item bg-dark text-white d-flex justify-content-between">
                            Kiểm tra máy chiếu phòng 5 <span class="text-success"><i class="bi bi-check-circle"></i></span>
                        </li>
                        <li class="list-group-item bg-dark text-white d-flex justify-content-between">
                            Họp nhân viên ca 2 lúc 13:30 <span class="text-warning"><i class="bi bi-clock"></i></span>
                        </li>
                        <li class="list-group-item bg-dark text-white d-flex justify-content-between">
                            Nhập kho combo mới (SP009) <span class="text-danger"><i class="bi bi-exclamation-triangle"></i></span>
                        </li>
                        <li class="list-group-item bg-dark text-white">
                            Phê duyệt nghỉ phép NV023
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card bg-dark text-white shadow-lg border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-bell"></i> Thông báo hệ thống</h5>
                </div>
                <div class="card-body small">
                    <div class="d-flex mb-3"><span class="text-danger me-2">•</span> Combo bắp rang bơ lớn (SP001) sắp hết hàng</div>
                    <div class="d-flex mb-3"><span class="text-info me-2">•</span> Khách VIP Mai Nhật Cường vừa đạt cấp độ 4</div>
                    <div class="d-flex mb-3"><span class="text-success me-2">•</span> Nhân viên Nguyễn Văn A đã điểm danh ca 2</div>
                    <div class="d-flex"><span class="text-primary me-2">•</span> Có 892 lượt đặt vé online đang chờ xử lý</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top nhân viên xuất sắc tuần này -->
    <div class="card bg-dark text-white shadow-lg border-0 mt-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-trophy"></i> Top 5 nhân viên xuất sắc tuần này</h5>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-6 col-md">
                    <img src="https://i.imgur.com/5z1lK8c.jpeg" class="rounded-circle mb-2" width="80">
                    <br><strong class="text-warning">1. Phạm Minh Phúc</strong><br>
                    <small class="text-success">428 vé • 92 triệu</small>
                </div>
                <div class="col-6 col-md">
                    <img src="https://i.imgur.com/8bY3kLm.jpeg" class="rounded-circle mb-2" width="80">
                    <br><strong>2. Nguyễn Lan Anh</strong><br><small>392 vé</small>
                </div>
                <div class="col-6 col-md">
                    <img src="https://i.imgur.com/H7kP9Qm.jpeg" class="rounded-circle mb-2" width="80">
                    <br><strong>3. Trần Văn Hùng</strong><br><small>358 vé</small>
                </div>
                <div class="col-6 col-md">
                    <img src="https://i.imgur.com/clover.jpg" class="rounded-circle mb-2" width="80">
                    <br><strong>4. Lê Thị Mai</strong><br><small>321 vé</small>
                </div>
                <div class="col-6 col-md">
                    <img src="https://i.imgur.com/unknown.jpg" class="rounded-circle mb-2" width="80">
                    <br><strong>5. Vũ Hoàng Nam</strong><br><small>298 vé</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueTodayChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Ca sáng (08-14)', 'Ca chiều (14-18)', 'Ca tối (18-22)', 'Ca khuya (22-02)'],
                datasets: [{
                    label: 'Doanh thu (triệu đồng)',
                    data: [98, 142, 188, 56],
                    backgroundColor: ['#00ff88', '#00ccff', '#ff66aa', '#ffaa00'],
                    borderRadius: 8,
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#444' }, ticks: { color: '#ccc' } },
                    x: { grid: { display: false }, ticks: { color: '#ccc' } }
                }
            }
        });
    </script>
}}

