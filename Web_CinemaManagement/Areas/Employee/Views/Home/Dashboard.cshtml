
@{
    ViewBag.Title = "Dashboard";
}

@{
    ViewBag.Title = "Dashboard - Quản trị";
    Layout = "~/Areas/Employee/Views/Shared/_LayoutPageEmployee.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/apexcharts@3.45.1/dist/apexcharts.css" rel="stylesheet">

<div class="container-fluid py-4">
    <h2 class="text-light mb-4">
        <i class="bi bi-speedometer2 me-2"></i> Dashboard - Tổng quan hệ thống
    </h2>

    <!-- 4 ô thống kê nhanh -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white shadow-lg border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-4">
                        <i class="bi bi-ticket-perforated fs-1"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">12,458</h5>
                        <small>Vé đã bán hôm nay</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white shadow-lg border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-4">
                        <i class="bi bi-currency-exchange fs-1"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">428.6 triệu</h5>
                        <small>Doanh thu hôm nay</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark shadow-lg border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-4">
                        <i class="bi bi-people fs-1"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">1,892</h5>
                        <small>Khách đang có mặt</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white shadow-lg border-0">
                <div class="card-body d-flex align-items-center">
                    <div class="me-4">
                        <i class="bi bi-film fs-1"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">24</h5>
                        <small>Suất chiếu đang chạy</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Biểu đồ doanh thu 7 ngày gần nhất -->
        <div class="col-lg-8">
            <div class="card bg-dark text-light shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Doanh thu 7 ngày gần nhất</h5>
                </div>
                <div class="card-body">
                    <div id="revenueChart"></div>
                </div>
            </div>
        </div>

        <!-- Top 5 phim ăn khách -->
        <div class="col-lg-4">
            <div class="card bg-dark text-light shadow-lg border-0">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-fire"></i> Top 5 phim ăn khách tuần này</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action bg-dark text-light d-flex justify-content-between align-items-center">
                            <div>
                                <strong>1. Deadpool & Wolverine</strong><br>
                                <small class="text-success">8,421 vé • 1.12 tỷ</small>
                            </div>
                            <span class="badge bg-danger rounded-pill">HOT</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                            <strong>2. Inside Out 2</strong><br><small class="text-info">6,238 vé</small>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                            <strong>3. Despicable Me 4</strong><br><small class="text-info">5,109 vé</small>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                            <strong>4. Black Pink World Tour</strong><br><small class="text-warning">4,876 vé</small>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action bg-dark text-light">
                            <strong>5. Twisters</strong><br><small class="text-muted">3,921 vé</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông báo hệ thống & hoạt động gần đây -->
    <div class="row g-4 mt-3">
        <div class="col-lg-6">
            <div class="card bg-dark text-light shadow-lg border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-bell"></i> Thông báo hệ thống</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <span class="text-danger">•</span> Máy chiếu phòng 3 đang bảo trì đến 18:00
                        </li>
                        <li class="mb-3">
                            <span class="text-success">•</span> Combo bắp rang bơ hết hàng (SP001)
                        </li>
                        <li class="mb-3">
                            <span class="text-info">•</span> Nhân viên Nguyễn Văn A nghỉ phép ngày mai
                        </li>
                        <li class="mb-3">
                            <span class="text-warning">•</span> Hệ thống đặt vé online đang có 1.284 người truy cập
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card bg-dark text-light shadow-lg border-0">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Hoạt động gần đây</h5>
                </div>
                <div class="card-body">
                    <small class="text-muted">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Nhân viên Phạm Minh Phúc vừa bán 3 vé phim Deadpool</span>
                            <span>14:28</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Bạn đã đăng nhập từ IP 113.172.22.105</span>
                            <span>14:15</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Khách VIP Mai Nhật Cường vừa đổi 500 điểm lấy combo</span>
                            <span>14:10</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Hóa đơn HD20250728089 đã được thanh toán thành công</span>
                            <span>14:05</span>
                        </div>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.1/dist/apexcharts.min.js"></script>
    <script>
        var options = {
            series: [{
                name: 'Doanh thu (triệu đồng)',
                data: [285, 320, 298, 410, 380, 456, 492]
            }],
            chart: {
                type: 'area',
                height: 380,
                foreColor: '#ccc',
                toolbar: { show: false }
            },
            colors: ['#00ff88'],
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 3 },
            xaxis: {
                categories: ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'Hôm nay'],
            },
            tooltip: {
                x: { format: 'dd/MM' },
                y: { formatter: val => val + ' triệu' }
            },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.7,
                    opacityTo: 0.3,
                }
            }
        };

        var chart = new ApexCharts(document.querySelector("#revenueChart"), options);
        chart.render();
    </script>
}

