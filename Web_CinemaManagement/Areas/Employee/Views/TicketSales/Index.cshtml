@model List<Web_CinemaManagement.Models.ModelLinq.SUATCHIEU>

@{
    ViewBag.Title = "Chọn Suất Chiếu";
    Layout = "~/Areas/Employee/Views/Shared/_LayoutPageEmployee.cshtml";
}

<link href="~/wwwroot/css/BanVeindex.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="card card-dark shadow-sm">
        <div class="card-header bg-primary text-white border-0">
            <h5 class="m-0 font-weight-bold"><i class="fa fa-calendar"></i> DANH SÁCH SUẤT CHIẾU</h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa fa-film fa-3x mb-3"></i><br />
                    Currently there are no showtimes scheduled.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark-custom table-hover">
                        <thead>
                            <tr>
                                <th>Phim</th>
                                <th>Phòng</th>
                                <th>Ngày chiếu</th>
                                <th>Thời gian</th>
                                <th class="text-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold">
                                        <i class="fa fa-film text-muted mr-2"></i>@item.PHIM.TENPHIM
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary">@item.PHONGCHIEU.TENPHONG</span>
                                    </td>
                                    <td>@string.Format("{0:dd/MM/yyyy}", item.NGAYCHIEU)</td>
                                    <td>
                                        <span class="text-success font-weight-bold">@item.GIOBATDAU</span>
                                        <span class="text-muted">- @item.GIOKETTHUC</span>
                                    </td>
                                    <td class="text-right">
                                        <a href="/Employee/TicketSales/BanVe?idSuat=@item.MASUAT" class="btn btn-warning btn-sm btn-chon">
                                            <i class="fa fa-ticket"></i> BÁN VÉ
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        console.log("Danh sách suất chiếu đã tải xong.");
    });
</script>