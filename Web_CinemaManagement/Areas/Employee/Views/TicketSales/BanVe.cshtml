@using Web_CinemaManagement.Models.ADO
@model List<Web_CinemaManagement.Models.ModelLinq.DICHVU>

@{
    ViewBag.Title = "Bán Vé";
    Layout = "~/Areas/Employee/Views/Shared/_LayoutPageEmployee.cshtml";
    var suat = (Web_CinemaManagement.Models.ModelLinq.SUATCHIEU)ViewBag.SuatChieu;
    var bill = TempData["Bill"] as HoaDonViewModel;
}


<link href="~/wwwroot/css/BanVe.css" rel="stylesheet" />

<div class="container-fluid mt-4">

    @if (bill != null)
    {
        <div class="bill-box shadow-sm">
            <div class="text-center border-bottom border-success pb-2 mb-3">
                <h4 class="font-weight-bold m-0"><i class="fa fa-check-circle"></i> ĐẶT VÉ THÀNH CÔNG</h4>
                <small>Mã đơn: @bill.MaNhanVien - Ngày: @bill.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <p><strong>Phim:</strong> @bill.TenPhim</p>
                    <p><strong>Suất:</strong> @bill.SuatChieu</p>
                    <p><strong>Phòng:</strong> @bill.Phong</p>
                </div>
                <div class="col-md-6 text-md-right">
                    <p><strong>Khách hàng:</strong> @bill.TenKhach</p>
                    <p class="text-danger"><strong>@bill.GiamGia</strong></p>
                    <p>Ghế: <span class="badge badge-success" style="font-size:1em">@bill.Ghe</span></p>
                </div>
            </div>

            @if (bill.DichVu != "Không")
            {
                <div class="alert alert-warning p-1 pl-2 mt-2" style="font-size:0.9em">
                    <strong>Dịch vụ:</strong> @bill.DichVu
                </div>
            }

            <div class="text-center mt-3 pt-2 border-top border-success">
                <h2 class="font-weight-bold text-success">@bill.TongTien.ToString("N0") đ</h2>
            </div>

            <div class="text-center mt-3 no-print">
                <button class="btn btn-primary" onclick="window.print()"><i class="fa fa-print"></i> IN HÓA ĐƠN</button>
                <a href="/Employee/TicketSales/Index" class="btn btn-outline-secondary ml-2">Về trang chủ</a>
            </div>
        </div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="fa fa-exclamation-triangle"></i> @TempData["Loi"]
        </div>
    }

    <div class="card bg-dark text-white border-warning mb-4 shadow-sm">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="m-0 text-highlight">@suat.PHIM.TENPHIM <span class="badge badge-danger ml-2">@ViewBag.TenDinhDang</span></h4>
                <div class="mt-1">
                    <i class="fa fa-map-marker text-danger"></i> @suat.PHONGCHIEU.TENPHONG &nbsp;|&nbsp;
                    <i class="fa fa-clock-o text-success"></i> @suat.GIOBATDAU - @suat.GIOKETTHUC
                </div>
            </div>
            <div class="text-right d-none d-md-block">
                <h5 class="m-0 text-muted">SL Ghế: @suat.SOLUONG</h5>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div class="card card-dark shadow-sm mb-4">
                <div class="card-header bg-secondary font-weight-bold">
                    1. CHỌN GHẾ & LOẠI VÉ
                </div>
                <div class="card-body">
                    <div class="form-row align-items-end">
                        <div class="col-md-5 form-group">
                            <label>Chọn ghế trống:</label>
                            @Html.DropDownList("ddlGhe", (SelectList)ViewBag.ListGheTrong, "--- Mời chọn ghế ---", new { @class = "form-control" })
                        </div>
                        <div class="col-md-5 form-group">
                            <label>Loại vé:</label>
                            @Html.DropDownList("ddlLoaiVe", (SelectList)ViewBag.ListLoaiVe, null, new { @class = "form-control" })
                        </div>
                        <div class="col-md-2 form-group">
                            <button class="btn btn-warning btn-block font-weight-bold" onclick="themVe()">
                                <i class="fa fa-plus"></i> THÊM
                            </button>
                        </div>
                    </div>

                    <hr class="bg-secondary" />

                    <h6 class="text-highlight mb-3">2. DỊCH VỤ (BẮP/NƯỚC)</h6>
                    <div style="height: 350px; overflow-y: auto; padding-right: 5px;">
                        @foreach (var dv in Model)
                        {
                            <div class="d-flex justify-content-between align-items-center service-item">
                                <div>
                                    <strong style="font-size: 1.1em">@dv.TENSP</strong><br />
                                    <span class="badge badge-secondary">@string.Format("{0:N0}", dv.DONGIA) đ</span>
                                </div>
                                <input type="number" min="0" value="0" class="form-control service-qty"
                                       data-id="@dv.MASP" onchange="updateData()">
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card card-dark shadow-sm">
                <div class="card-header bg-warning text-dark font-weight-bold">
                    3. THÔNG TIN THANH TOÁN
                </div>
                <div class="card-body">
                    <div style="min-height: 200px;">
                        <table class="table table-sm table-dark-custom table-hover">
                            <thead>
                                <tr>
                                    <th>Ghế</th>
                                    <th>Loại vé</th>
                                    <th class="text-right">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="cart-display">
                            </tbody>
                        </table>
                        <div id="empty-cart-msg" class="text-center text-muted mt-4">
                            <i>(Chưa có vé nào được chọn)</i>
                        </div>
                    </div>

                    <hr class="bg-secondary" />

                    <form action="/Employee/TicketSales/DatVe" method="post">
                        <input type="hidden" name="idSuat" value="@suat.MASUAT" />
                        <input type="hidden" name="strGhe" id="hiddenStrGhe" />
                        <input type="hidden" name="strDichVu" id="hiddenStrDichVu" />

                        <div class="form-group">
                            <label class="text-highlight">Số điện thoại Khách hàng:</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-phone"></i></span>
                                </div>
                                <input type="text" name="sdtKhach" class="form-control" placeholder="Nhập SĐT để tích điểm/giảm giá...">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg btn-block mt-4 font-weight-bold py-3">
                            <i class="fa fa-check"></i> ĐẶT VÉ NGAY
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="~/wwwroot/js/BanVe.js"></script>